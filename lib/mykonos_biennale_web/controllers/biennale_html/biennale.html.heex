<div class="min-h-screen bg-black text-white">
  <%= if !@biennale do %>
    <div class="min-h-screen flex items-center justify-center">
      <h1 class="text-3xl font-bold uppercase">Mykonos Biennale</h1>
    </div>
  <% else %>
    <%!-- Hero Section --%>
    <div
      :if={@biennale_media != []}
      class="relative min-h-screen flex items-center justify-center bg-cover bg-center bg-no-repeat px-4"
      style={
        if media_url(List.first(@biennale_media), size: "hero"),
          do: "background-image: url('#{media_url(List.first(@biennale_media), size: "hero")}');",
          else: ""
      }
    >
      <div class="bg-black/40 p-8 text-center text-white">
        <h1 class="text-5xl md:text-7xl font-bold uppercase mb-4">{@biennale.fields["theme"]}</h1>
        <p class="text-2xl md:text-3xl text-gray-300 font-light">{@biennale.fields["year"]}</p>
        <%= if @biennale.fields["start_date"] && @biennale.fields["end_date"] do %>
          <p class="text-lg text-gray-400 mt-4">
            {format_date(@biennale.fields["start_date"])} – {format_date(
              @biennale.fields["end_date"]
            )}
          </p>
        <% end %>
      </div>
    </div>

    <%!-- Fallback hero when no media --%>
    <div :if={@biennale_media == []} class="min-h-[60vh] flex items-center justify-center px-4">
      <div class="text-center">
        <h1 class="text-5xl md:text-7xl font-bold uppercase mb-4">{@biennale.fields["theme"]}</h1>
        <p class="text-2xl md:text-3xl text-gray-300 font-light">{@biennale.fields["year"]}</p>
        <%= if @biennale.fields["start_date"] && @biennale.fields["end_date"] do %>
          <p class="text-lg text-gray-400 mt-4">
            {format_date(@biennale.fields["start_date"])} – {format_date(
              @biennale.fields["end_date"]
            )}
          </p>
        <% end %>
      </div>
    </div>

    <%!-- Statement Section --%>
    <%= if @biennale.fields["statement"] do %>
      <div class="bg-[#222] text-white py-20 px-6">
        <div class="mx-auto max-w-5xl">
          <h2 class="text-3xl font-light italic mb-10 text-center">
            {@biennale.fields["theme"]}
          </h2>
          <p class="text-sm leading-relaxed text-gray-300">{@biennale.fields["statement"]}</p>
        </div>
      </div>
    <% end %>

    <%!-- Events Grid --%>
    <%= if @events != [] do %>
      <% remainder = rem(length(@events), 4) %>
      <% {last_span, penultimate_span} =
        cond do
          remainder == 1 -> {"lg:col-span-4", "lg:col-span-2 md:col-span-1"}
          remainder == 3 -> {"lg:col-span-2", nil}
          true -> {nil, nil}
        end %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
        <%= for {event, idx} <- Enum.with_index(@events) do %>
          <% is_last = idx == length(@events) - 1 %>
          <% is_penultimate = idx == length(@events) - 2 %>
          <% span_class =
            cond do
              is_last && last_span -> last_span
              is_penultimate && penultimate_span -> penultimate_span
              true -> ""
            end %>

          <div class={[
            "flex flex-col h-full border-b border-r border-gray-100 text-[#444]",
            span_class
          ]}>
            <div
              :if={event.background_image}
              class="h-64 bg-cover bg-center"
              style={"background-image: url('#{event.background_image}');"}
            >
            </div>
            <div
              :if={is_nil(event.background_image)}
              class="h-64 bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center"
            >
              <span class="text-5xl text-gray-400">{String.slice(event.title || "", 0, 1)}</span>
            </div>
            <div class={"#{if rem(idx, 2) == 0, do: "bg-gray-50", else: "bg-white"} flex-grow p-8"}>
              <h3 class="text-xl font-bold uppercase mb-4">
                <a href={"/event/#{event.id}"} class="hover:text-purple-600 transition-colors">
                  {event.title}
                </a>
              </h3>
              <%!-- <%= if event.date do %>
              <p class="text-xs font-bold text-gray-400 mb-4 uppercase tracking-widest">{format_date(event.date)}</p>
            <% end %> --%>
              <%= if event.description do %>
                <p class="text-sm leading-relaxed text-gray-600 mb-4">{event.description}</p>
              <% end %>
              <%= if event.participants != [] do %>
                <p class="text-xs text-gray-500 mb-2">
                  <%= for {id, name} <- event.participants do %>
                    <a href={"/artist/#{id}"} class="hover:text-[#f2ba49] transition-colors">
                      {name}
                    </a>
                    {unless id == List.last(Enum.map(event.participants, &elem(&1, 0))), do: " · "}
                  <% end %>
                </p>
              <% end %>
              <a
                href={"/biennale/#{event.slug}"}
                class="text-xs font-bold uppercase text-[#f2ba49] hover:underline"
              >
                View Details
              </a>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%!-- Projects Section --%>
    <%= if @projects != [] do %>
      <div class="bg-[#222] py-20 px-6">
        <div class="max-w-7xl mx-auto">
          <h2 class="text-3xl font-bold uppercase mb-12 text-center text-gray-300">
            Projects {@biennale.fields["year"]}
          </h2>
          <div class="flex flex-wrap justify-center gap-8">
            <%= for project <- @projects do %>
              <% media_list = Map.get(@project_media, project.id, [])
              first_media = List.first(media_list)

              bg_style =
                if first_media do
                  "background-image: url('" <>
                    MykonosBiennale.Uploads.media_url(first_media, size: :card) <>
                    "'); background-size: cover; background-position: center;"
                else
                  ""
                end %>
              <div class="group cursor-pointer w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.375rem)]">
                <div class="aspect-square bg-gray-800 mb-4 relative overflow-hidden">
                  <%= if first_media do %>
                    <div
                      class="absolute inset-0 group-hover:scale-105 transition-transform duration-500"
                      style={bg_style}
                    >
                    </div>
                  <% else %>
                    <div class="absolute inset-0 bg-gradient-to-br from-gray-700 to-black group-hover:scale-105 transition-transform duration-500">
                    </div>
                  <% end %>
                </div>
                <h3 class="text-xl font-bold uppercase mb-2">
                  <%= if event_id = Map.get(@project_event_map, project.id) do %>
                    <a href={"/event/#{event_id}"} class="hover:text-[#f2ba49] transition-colors">
                      {Map.get(@project_event_titles, project.id) || project.title}
                    </a>
                  <% else %>
                    {project.title}
                  <% end %>
                </h3>
                <%= if project.description do %>
                  <p class="text-gray-500 text-sm line-clamp-2">{project.description}</p>
                <% end %>
                <%= if project.participants != [] do %>
                  <p class="text-xs text-gray-600 mt-2">
                    <%= for {id, name} <- project.participants do %>
                      <a href={"/artist/#{id}"} class="hover:text-[#f2ba49] transition-colors">
                        {name}
                      </a>
                      {unless id == List.last(Enum.map(project.participants, &elem(&1, 0))),
                        do: " · "}
                    <% end %>
                  </p>
                <% end %>
                <%= if project.directors != [] do %>
                  <p class="text-xs text-gray-600 mt-1">
                    Dir.
                    <%= for {id, name} <- project.directors do %>
                      <a href={"/artist/#{id}"} class="hover:text-[#f2ba49] transition-colors">
                        {name}
                      </a>
                      {unless id == List.last(Enum.map(project.directors, &elem(&1, 0))),
                        do: " · "}
                    <% end %>
                  </p>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%!-- Footer --%>
    <footer class="bg-[#222] text-gray-500 py-12 px-6 text-center">
      <p class="text-xs uppercase tracking-widest">
        &copy; {@biennale.fields["year"]} Mykonos Biennale — All Rights Reserved
      </p>
    </footer>
  <% end %>
</div>
