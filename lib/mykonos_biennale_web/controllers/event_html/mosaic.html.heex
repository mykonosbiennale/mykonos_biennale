<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{@page_title}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.min.css"
    />
    <style>
      /* Self-contained: this layout does not depend on the Tailwind CDN. */
      * { box-sizing: border-box; }
      body { margin: 0; background: #0a0a0a; color: #e5e5e5; font-family: system-ui, sans-serif; min-height: 100vh; }
      a { color: inherit; text-decoration: none; }
      .topbar { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; border-bottom: 1px solid #262626; }
      .brand { font-weight: 600; letter-spacing: 0.08em; color: #fff; }
      .links { display: flex; gap: 1.5rem; font-size: 0.875rem; color: #a3a3a3; }
      .links a:hover { color: #fff; }
      .wrap { max-width: 1600px; margin: 0 auto; padding: 2rem 0.5rem; }
      .head { padding: 0 1rem 1.5rem; }
      .head h1 { margin: 0 0 0.5rem; font-size: 1.75rem; color: #fff; }
      .meta { font-size: 0.875rem; color: #737373; }
      .desc { max-width: 42rem; margin-top: 1rem; color: #a3a3a3; line-height: 1.6; white-space: pre-line; }
      .mosaic { column-count: 2; column-gap: 0.5rem; }
      .tile { break-inside: avoid; margin: 0 0 0.5rem; }
      .tile img { display: block; width: 100%; height: auto; border-radius: 2px; }
      .caption { margin-top: 0.25rem; font-size: 0.75rem; color: #737373; }
      .foot { border-top: 1px solid #262626; padding: 1.5rem; margin-top: 3rem; font-size: 0.875rem; color: #525252; text-align: center; }
      @media (min-width: 768px) { .mosaic { column-count: 3; } }
      @media (min-width: 1280px) { .mosaic { column-count: 5; } }
      .pswp { --pswp-bg: #000; }
    </style>
  </head>
  <body>
    <nav class="topbar">
      <a href="/" class="brand">MYKONOS BIENNALE</a>
      <div class="links">
        <a href="/archive">Archive</a>
        <a href="/program">Program</a>
        <a href="/about">About</a>
      </div>
    </nav>

    <main class="wrap" id="main">
      <div class="head">
        <.event_header event={@event} biennale={@biennale} />

        <%= if field(@event, "description") do %>
          <p class="desc">{field(@event, "description")}</p>
        <% end %>
      </div>

      <section :if={@media != []} class="mosaic">
        <%= for m <- @media do %>
          <figure class="tile">
            <a
              href={media_url(m, size: "hero")}
              data-pswp-width="1920"
              data-pswp-height="1080"
              target="_blank"
            >
              <img
                src={media_url(m, size: "card")}
                alt={m.alt_text || m.caption || field(@event, "title")}
                loading="lazy"
              />
            </a>
            <figcaption :if={m.caption} class="caption">{m.caption}</figcaption>
          </figure>
        <% end %>
      </section>
    </main>

    <footer class="foot">Mykonos Biennale</footer>

    <script src="https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/umd/photoswipe-lightbox.umd.min.js">
    </script>
    <script>
      const lightbox = new PhotoSwipeLightbox({
        gallery: '#main',
        children: 'a[data-pswp-width]',
        pswpModule: () => import('https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.esm.js'),
      });
      lightbox.init();
    </script>
  </body>
</html>
