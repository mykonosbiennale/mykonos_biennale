<Layouts.app flash={@flash}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="flex items-center justify-between mb-4">
      <h1 class="text-lg font-semibold text-gray-100">Team Members</h1>
      <.link
        patch="/admin/teams/new"
        class="px-3 py-1 bg-purple-600 hover:bg-purple-700 text-white text-xs font-medium rounded transition-colors"
      >
        + Add Team Member
      </.link>
    </div>

    <div class="bg-gray-800/30 backdrop-blur-sm rounded-lg border border-purple-500/20 overflow-hidden">
      <table class="w-full">
        <thead class="bg-gray-900/50 border-b border-purple-500/20">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-400">Participant</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-400">Biennales</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-400">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-700/50">
          <%= for member <- @team do %>
            <tr class="hover:bg-gray-700/20 transition-colors">
              <td class="px-6 py-4">
                <.link
                  navigate={"/admin/participants/#{member.participant_id}"}
                  class="text-white font-medium hover:text-purple-300 transition-colors"
                >
                  {member.name}
                </.link>
              </td>
              <td class="px-6 py-4">
                <div class="flex flex-wrap gap-2">
                  <%= for m <- member.memberships do %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs bg-purple-500/10 border border-purple-500/20">
                      <span class="text-purple-300 font-medium">{m.year}</span>
                      <span class="text-gray-400">({m.role})</span>
                      <button
                        type="button"
                        phx-click="remove_membership"
                        phx-value-rel-id={m.rel_id}
                        data-confirm="Remove membership in #{m.year}?"
                        class="text-gray-600 hover:text-red-400"
                        title="Remove #{m.year}"
                      >
                        <.icon name="hero-x-mark" class="w-3 h-3" />
                      </button>
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 text-right whitespace-nowrap">
                <.link
                  navigate={"/admin/teams/#{member.participant_id}"}
                  class="text-purple-400 hover:text-purple-300 transition-colors text-xs mr-3"
                >
                  Edit
                </.link>
                <button
                  phx-click="delete"
                  phx-value-participant-id={member.participant_id}
                  data-confirm="Remove this team member from all biennales?"
                  class="text-red-400 hover:text-red-300 transition-colors text-xs"
                >
                  Delete
                </button>
              </td>
            </tr>
          <% end %>
          <%= if @team == [] do %>
            <tr>
              <td colspan="3" class="px-6 py-8 text-center text-sm text-gray-500">
                No team members yet.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <.modal
    :if={@live_action == :new}
    id="team-member-modal"
    show
    on_cancel={JS.patch("/admin/teams")}
  >
    <div data-theme="light" class="bg-white rounded-xl p-6 [&_.label]:text-gray-900">
      <h2 class="text-sm font-semibold text-gray-900 mb-4">Add Team Member</h2>

      <form phx-submit="add_team_member" class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-gray-900 mb-1">Participant</label>
          <%= if @selected_participant do %>
            <div class="flex items-center justify-between bg-gray-50 rounded-lg p-3">
              <span class="text-sm font-medium text-gray-900">
                {@selected_participant.identity}
              </span>
              <button
                type="button"
                phx-click="clear_participant"
                class="text-red-600 hover:text-red-700 text-xs"
              >
                Change
              </button>
            </div>
          <% else %>
            <input
              type="text"
              name="participant_search"
              value={@participant_search}
              placeholder="Search participants..."
              phx-change="search_participants"
              phx-debounce="300"
              class="w-full rounded-lg border-gray-300 bg-white text-gray-900 px-3 py-2"
            />
            <%= if @participant_results != [] do %>
              <div class="border border-gray-200 rounded-lg max-h-48 overflow-y-auto divide-y divide-gray-100 mt-2">
                <button
                  :for={p <- @participant_results}
                  type="button"
                  phx-click="select_participant"
                  phx-value-participant-id={p.id}
                  class="w-full text-left px-3 py-2 hover:bg-blue-50 text-sm text-gray-900"
                >
                  {p.identity}
                </button>
              </div>
            <% end %>
          <% end %>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-900 mb-1">Role</label>
          <select
            name="role"
            class="w-full rounded-lg border-gray-300 bg-white text-gray-900 px-3 py-2"
          >
            <option value="">Select role...</option>
            <%= for {value, label} <- @team_roles do %>
              <option value={value}>{label}</option>
            <% end %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-900 mb-1">Biennales</label>
          <div class="space-y-1">
            <%= for b <- @biennales do %>
              <label class="flex items-center gap-2 text-sm text-gray-900">
                <input
                  type="checkbox"
                  name={"biennale_#{b.id}"}
                  value="true"
                  class="rounded border-gray-300"
                />
                {b.fields["year"]}
              </label>
            <% end %>
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <.link
            patch="/admin/teams"
            class="text-sm font-semibold text-gray-500 hover:text-gray-700"
          >
            Cancel
          </.link>
          <button
            type="submit"
            class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white text-sm font-medium rounded-lg"
          >
            Add Team Member
          </button>
        </div>
      </form>
    </div>
  </.modal>
</Layouts.app>
